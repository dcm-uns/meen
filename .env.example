# Configuración de MongoDB
# URL de conexión a la base de datos MongoDB
# Ejemplo para MongoDB local: mongodb://127.0.0.1:27017
# Ejemplo para MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://127.0.0.1:27017

# Nombre de la base de datos
# El valor por defecto es 'sample_mflix' si no se especifica
DB_NAME=sample_mflix

# Configuración del servidor Express
# Puerto donde escucha la aplicación
PORT=3000

# Host del servidor
HOST=localhost
